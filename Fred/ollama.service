# systemd service for Ollama
# Ollama's official installer usually creates this automatically.
# Use this file only if it didn't, or if you need to customise it.
#
# Install:
#   sudo cp Fred/ollama.service /etc/systemd/system/ollama.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable ollama
#   sudo systemctl start ollama
#
# Logs:
#   sudo journalctl -u ollama -f

[Unit]
Description=Ollama LLM Server
After=network-online.target

[Service]
Type=simple
User=ollama
Group=ollama
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3

# Keep the model loaded between requests (5 min idle timeout)
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_HOST=127.0.0.1:11434
# Limit VRAM usage on CPU-only VPS
Environment=OLLAMA_NUM_PARALLEL=1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
