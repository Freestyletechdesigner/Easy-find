# systemd service for Fred (FastAPI / Uvicorn)
# Install:
#   sudo cp Fred/fred.service /etc/systemd/system/fred.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable fred
#   sudo systemctl start fred
#
# Logs:
#   sudo journalctl -u fred -f

[Unit]
Description=Fred AI Engine (EasyFind FastAPI)
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/easyfind
# Activate the Python venv and run uvicorn
ExecStart=/var/www/easyfind/Fred/venv/bin/uvicorn Fred.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment — uvicorn inherits the system .env via main.py's loader
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_SYMLINKS_WARNING=1

[Install]
WantedBy=multi-user.target
